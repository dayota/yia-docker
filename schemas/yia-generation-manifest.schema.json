{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yia.local/schemas/yia-generation-manifest.schema.json",
  "title": "Yia generated files manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "yia_version",
    "configuration_schema_version",
    "configuration_hash",
    "generators",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "const": 1
    },
    "yia_version": {
      "type": "string",
      "minLength": 1
    },
    "configuration_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generators": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "enum": [
              420,
              493
            ]
          }
        }
      }
    }
  }
}
