{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yia.local/schemas/yia-state.schema.json",
  "title": "Yia internal state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_schema_version",
    "yia_version",
    "configuration_schema_version",
    "documentation_schema_version",
    "configuration_hash"
  ],
  "properties": {
    "state_schema_version": {
      "type": "integer",
      "const": 1
    },
    "yia_version": {
      "type": "string",
      "minLength": 1
    },
    "configuration_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "documentation_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
